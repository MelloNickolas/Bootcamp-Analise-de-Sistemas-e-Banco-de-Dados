# Copie este arquivo para ".env" (na mesma pasta) e troque os valores.
# O ".env" nunca vai para o GitHub.

# Conexão com o PostgreSQL (local). No Neon, cole a URI "postgresql://..." inteira.
CONNECTION_STRING=Host=localhost;Port=5432;Database=tomodachi;Username=postgres;Password=TROQUE_AQUI

# Endereços do PWA liberados no CORS, separados por vírgula
CORS_ORIGINS=http://localhost:5173

# Firebase (envio das notificações). Sem isso, a API só simula o envio no log.
# Aponte para o arquivo JSON da conta de serviço, guardado FORA do repositório.
# Em produção, use FIREBASE_CREDENTIALS_JSON com o conteúdo do arquivo.
FIREBASE_CREDENTIALS_PATH=C:\caminho\fora\do\repositorio\firebase-credenciais.json

# Chave que o agendador externo envia no cabeçalho X-Job-Key para disparar as notificações.
# Invente um texto longo e aleatório.
JOB_KEY=TROQUE_AQUI

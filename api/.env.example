# Copie este arquivo para ".env" (na mesma pasta) e troque os valores.
# O ".env" nunca vai para o GitHub.

# Conexão com o PostgreSQL (local). No Neon, cole a URI "postgresql://..." inteira.
CONNECTION_STRING=Host=localhost;Port=5432;Database=tomodachi;Username=postgres;Password=TROQUE_AQUI

# Endereços do PWA liberados no CORS, separados por vírgula
CORS_ORIGINS=http://localhost:5173

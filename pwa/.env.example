# Copie este arquivo para ".env" (na mesma pasta). O ".env" nunca vai para o GitHub.

# Endereço da API
VITE_API_URL=http://localhost:5080

# Firebase: Configurações do projeto > Seus apps > app da Web (Configuração do SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase: Configurações do projeto > Cloud Messaging > Certificados push da Web (chave pública)
VITE_FIREBASE_VAPID_KEY=
